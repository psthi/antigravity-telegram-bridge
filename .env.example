# Telegram Bot Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Your Telegram Chat ID (Send a message to your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates to find it)
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Optional: The persistent conversation ID the bot should route prompts to. 
# If left blank, it defaults to 'telegram-bridge-session'
AGY_CONVERSATION_ID="my-remote-session"

# Optional: Absolute path to the Antigravity 'agy' CLI binary. 
# Leave blank to auto-detect from system PATH.
AGY_PATH=""
